-- playstation spu, modeled on duckstation: 24 voices at 44.1 khz, adpcm, gaussian interpolation,
-- hardware adsr/sweeps, noise, endx/kon/koff, capture buffers, and the 22050 hz reverb.
-- no host audio device: mixed stereo frames sit in a bounded fifo for probes/frontends.
local SPU = {}
SPU.__index = SPU

local band = bit32.band
local bor = bit32.bor
local bxor = bit32.bxor
local bnot = bit32.bnot
local lshift = bit32.lshift
local rshift = bit32.rshift

local BASE = 0x1F801C00
local RAM_MASK = 0x7FFFF
local RAM_HALFWORDS = 0x40000
local MASTER_TO_SAMPLE = 768
local VOICES = 24
local BLOCK_SAMPLES = 28
local SAMPLE_MASK = BLOCK_SAMPLES * 4096 - 1

-- precomputed 1<<(i-1) so per-frame voice loops don't call lshift 24x.
local VOICE_BITS = {}
for i = 1, VOICES do VOICE_BITS[i] = lshift(1, i - 1) end

-- adpcm block decode blend coefficients (duckstation g_spu_blend_pos/neg).
local BLEND_POS = { 0, 60, 115, 98, 122 }
local BLEND_NEG = { 0, 0, -52, -55, -60 }
local MAX16 = 0x7FFF
local MIN16 = -0x8000

-- spu dma: 32-halfword transfer fifo at 16 cpu ticks/halfword; the request line follows fifo full/empty.
local TRANSFER_FIFO_SIZE = 32
local TRANSFER_TICKS_PER_HALFWORD = 16

-- spucnt bits 4-5: ram transfer mode (duckstation ramtransfermode).
local function getTransferMode(spucnt)
	return band(rshift(spucnt, 4), 0x3)
end

local function s16(v)
	v = band(v, 0xFFFF)
	return v >= 0x8000 and v - 0x10000 or v
end

local function u16(v)
	return band(v, 0xFFFF)
end

local function arshift(v, n)
	-- integer floor division == arithmetic shift (duckstation s32 >> n);
	-- avoids the float divide + math.floor of v / 2^n.
	return v // lshift(1, n)
end

local function clamp16(v)
	if v < MIN16 then return MIN16 end
	if v > MAX16 then return MAX16 end
	return math.floor(v)
end

local function mul16(a, b)
	return (a * b) // 32768
end

-- duckstation reverb neg(): -32768 maps to 0x7fff rather than +32768.
local function neg(v)
	return (v == -0x8000) and 0x7FFF or -v
end

